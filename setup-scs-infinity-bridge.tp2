  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~Infinity_FetchString(char.race) .. "\n" .. char.class .. "\n" .. Infinity_FetchString(char.alignment)~) >= 0 BEGIN
    REPLACE_TEXTUALLY EXACT_MATCH ~Infinity_FetchString(char.race) .. "\n" .. char.class .. "\n" .. Infinity_FetchString(char.alignment)~ ~Infinity_FetchString(char.race) .. "\n" .. rgCleanSCSClassLabel(char.class) .. "\n" .. Infinity_FetchString(char.alignment)~
  END
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~string.match(characters[id].classlevel.first.details, '%d.')~) >= 0 BEGIN
