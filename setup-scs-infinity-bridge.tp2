  END
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~text lua "dwFilterKitDesc(rgGetChargenInfo(4))"~) >= 0 BEGIN
    REPLACE_TEXTUALLY EXACT_MATCH ~text lua "dwFilterKitDesc(rgGetChargenInfo(4))"~ ~text lua "rgCleanSCSClassLabel(rgGetChargenInfo(4))"~
  END
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~text lua "rgGetChargenInfo(4)"~) >= 0 BEGIN
    REPLACE_TEXTUALLY EXACT_MATCH ~text lua "rgGetChargenInfo(4)"~ ~text lua "rgCleanSCSClassLabel(rgGetChargenInfo(4))"~
  END
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~text lua "dwFilterKitDesc(character_select[rowNumber].name)"~) >= 0 BEGIN
