BACKUP ~scs-infinity-bridge/backup~
AUTHOR ~Infinity UI / SCS compatibility contributors~
VERSION ~0.5.4-alpha~

// All components independent; no auto-install of SCS features.
// SCS install detection reads the standard WeiDU.log; no fixed version dependency.
// Install after both mods and after other UI-changing mods.

BEGIN ~Class/kit labels and character record levels (working-v3-derived)~
DESIGNATED 0
REQUIRE_PREDICATE (MOD_IS_INSTALLED ~infinity_ui/infinity_ui.tp2~ 0) ~Requires Infinity UI++ core.~
REQUIRE_PREDICATE (FILE_CONTAINS ~WeiDU.log~ ~STRATAGEMS/SETUP-STRATAGEMS[.]TP2~) ~Requires an installed SCS component.~

COPY_EXISTING ~UI.menu~ ~override~
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~listMetaInfo = {}~) < 0 BEGIN
    PATCH_FAIL ~Unknown UI.menu: Infinity UI++ entry point not found; refusing edits.~
  END
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~function rgCleanSCSClassLabel(~) < 0 BEGIN
    REPLACE_TEXTUALLY EXACT_MATCH ~listMetaInfo = {}~ ~-- SCS class labels: presentation only. No changes to the TLK or gameplay.%WNL%function rgCleanSCSClassLabel(value)%WNL%    if type(value) == "string" then%WNL%        local p = string.char(37)%WNL%        local pattern = p.."s*"..p.."{[Kk]"..p.."s*="..p.."s*"..p.."d+"..p.."s*,"..p.."s*[Cc]"..p.."s*="..p.."s*"..p.."d+"..p.."s*}"%WNL%        return (value:gsub(pattern, ""))%WNL%    end%WNL%    return value%WNL%end%WNL%%WNL%listMetaInfo = {}~
  END
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~		table.insert(listItems, { 'rgempty','0', characters[currentID].classlevel.first.details .. '\n' })~) >= 0 BEGIN
    REPLACE_TEXTUALLY EXACT_MATCH ~		table.insert(listItems, { 'rgempty','0', characters[currentID].classlevel.first.details .. '\n' })~ ~		table.insert(listItems, { 'rgempty','0', rgCleanSCSClassLabel(characters[currentID].classlevel.first.details) .. '\n' })~
  END
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~			table.insert(listItems, { 'rgempty','0', characters[currentID].classlevel.second.details .. '\n'})~) >= 0 BEGIN
    REPLACE_TEXTUALLY EXACT_MATCH ~			table.insert(listItems, { 'rgempty','0', characters[currentID].classlevel.second.details .. '\n'})~ ~			table.insert(listItems, { 'rgempty','0', rgCleanSCSClassLabel(characters[currentID].classlevel.second.details) .. '\n'})~
  END
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~			table.insert(listItems, { 'rgempty','0', characters[currentID].classlevel.third.details .. '\n'})~) >= 0 BEGIN
    REPLACE_TEXTUALLY EXACT_MATCH ~			table.insert(listItems, { 'rgempty','0', characters[currentID].classlevel.third.details .. '\n'})~ ~			table.insert(listItems, { 'rgempty','0', rgCleanSCSClassLabel(characters[currentID].classlevel.third.details) .. '\n'})~
  END
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~	out = out .. '\n\n' .. characters[currentID].kitDesc%WNL%%WNL%	return out~) >= 0 BEGIN
    REPLACE_TEXTUALLY EXACT_MATCH ~	out = out .. '\n\n' .. characters[currentID].kitDesc%WNL%%WNL%	return out~ ~	out = out .. '\n\n' .. characters[currentID].kitDesc%WNL%%WNL%	return rgCleanSCSClassLabel(out)~
  END
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~	return char.name .. ' - ' .. char.class .. ""~) >= 0 BEGIN
    REPLACE_TEXTUALLY EXACT_MATCH ~	return char.name .. ' - ' .. char.class .. ""~ ~	return char.name .. ' - ' .. rgCleanSCSClassLabel(char.class) .. ""~
  END
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~		rgClass = ',' .. characters[currentID].classlevel.first.details~) >= 0 BEGIN
    REPLACE_TEXTUALLY EXACT_MATCH ~		rgClass = ',' .. characters[currentID].classlevel.first.details~ ~		rgClass = ',' .. rgCleanSCSClassLabel(characters[currentID].classlevel.first.details)~
  END
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~		rgLevel = string.match(characters[currentID].classlevel.first.details, '%d.')~) >= 0 BEGIN
    REPLACE_TEXTUALLY EXACT_MATCH ~		rgLevel = string.match(characters[currentID].classlevel.first.details, '%d.')~ ~		rgLevel = string.match(rgCleanSCSClassLabel(characters[currentID].classlevel.first.details), '%d.')~
  END
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~		rgClass = ',' .. characters[currentID].classlevel.second.details~) >= 0 BEGIN
    REPLACE_TEXTUALLY EXACT_MATCH ~		rgClass = ',' .. characters[currentID].classlevel.second.details~ ~		rgClass = ',' .. rgCleanSCSClassLabel(characters[currentID].classlevel.second.details)~
  END
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~		rgLevel = string.match(characters[currentID].classlevel.second.details, '%d.')~) >= 0 BEGIN
    REPLACE_TEXTUALLY EXACT_MATCH ~		rgLevel = string.match(characters[currentID].classlevel.second.details, '%d.')~ ~		rgLevel = string.match(rgCleanSCSClassLabel(characters[currentID].classlevel.second.details), '%d.')~
  END
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~		rgClass = ',' .. characters[currentID].classlevel.third.details ~) >= 0 BEGIN
    REPLACE_TEXTUALLY EXACT_MATCH ~		rgClass = ',' .. characters[currentID].classlevel.third.details ~ ~		rgClass = ',' .. rgCleanSCSClassLabel(characters[currentID].classlevel.third.details) ~
  END
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~		rgLevel = string.match(characters[currentID].classlevel.third.details, '%d.')~) >= 0 BEGIN
    REPLACE_TEXTUALLY EXACT_MATCH ~		rgLevel = string.match(characters[currentID].classlevel.third.details, '%d.')~ ~		rgLevel = string.match(rgCleanSCSClassLabel(characters[currentID].classlevel.third.details), '%d.')~
  END
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~		rgLevel = string.match(characters[currentID].classlevel.first.details, '%d.')~) >= 0 BEGIN
    REPLACE_TEXTUALLY EXACT_MATCH ~		rgLevel = string.match(characters[currentID].classlevel.first.details, '%d.')~ ~		rgLevel = string.match(rgCleanSCSClassLabel(characters[currentID].classlevel.first.details), '%d.')~
  END
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~		rgLevel = string.match(characters[currentID].classlevel.second.details, '%d.')~) >= 0 BEGIN
    REPLACE_TEXTUALLY EXACT_MATCH ~		rgLevel = string.match(characters[currentID].classlevel.second.details, '%d.')~ ~		rgLevel = string.match(rgCleanSCSClassLabel(characters[currentID].classlevel.second.details), '%d.')~
  END
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~		rgLevel = string.match(characters[currentID].classlevel.third.details, '%d.')~) >= 0 BEGIN
    REPLACE_TEXTUALLY EXACT_MATCH ~		rgLevel = string.match(characters[currentID].classlevel.third.details, '%d.')~ ~		rgLevel = string.match(rgCleanSCSClassLabel(characters[currentID].classlevel.third.details), '%d.')~
  END
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~		rgClass = ',' .. characters[currentID].classlevel.first.details~) >= 0 BEGIN
    REPLACE_TEXTUALLY EXACT_MATCH ~		rgClass = ',' .. characters[currentID].classlevel.first.details~ ~		rgClass = ',' .. rgCleanSCSClassLabel(characters[currentID].classlevel.first.details)~
  END
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~		rgClass = ',' .. characters[currentID].classlevel.second.details~) >= 0 BEGIN
    REPLACE_TEXTUALLY EXACT_MATCH ~		rgClass = ',' .. characters[currentID].classlevel.second.details~ ~		rgClass = ',' .. rgCleanSCSClassLabel(characters[currentID].classlevel.second.details)~
  END
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~		rgClass = ',' .. characters[currentID].classlevel.third.details~) >= 0 BEGIN
    REPLACE_TEXTUALLY EXACT_MATCH ~		rgClass = ',' .. characters[currentID].classlevel.third.details~ ~		rgClass = ',' .. rgCleanSCSClassLabel(characters[currentID].classlevel.third.details)~
  END
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~		rgClass = ',' .. characters[rgInvId].classlevel.first.details~) >= 0 BEGIN
    REPLACE_TEXTUALLY EXACT_MATCH ~		rgClass = ',' .. characters[rgInvId].classlevel.first.details~ ~		rgClass = ',' .. rgCleanSCSClassLabel(characters[rgInvId].classlevel.first.details)~
  END
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~		rgClass = ',' .. characters[rgInvId].classlevel.second.details~) >= 0 BEGIN
    REPLACE_TEXTUALLY EXACT_MATCH ~		rgClass = ',' .. characters[rgInvId].classlevel.second.details~ ~		rgClass = ',' .. rgCleanSCSClassLabel(characters[rgInvId].classlevel.second.details)~
  END
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~		rgClass = ',' .. characters[rgInvId].classlevel.third.details ~) >= 0 BEGIN
    REPLACE_TEXTUALLY EXACT_MATCH ~		rgClass = ',' .. characters[rgInvId].classlevel.third.details ~ ~		rgClass = ',' .. rgCleanSCSClassLabel(characters[rgInvId].classlevel.third.details) ~
  END
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~		text lua "rgString(characters[rgInvId].class)"~) >= 0 BEGIN
    REPLACE_TEXTUALLY EXACT_MATCH ~		text lua "rgString(characters[rgInvId].class)"~ ~		text lua "rgCleanSCSClassLabel(rgString(characters[rgInvId].class))"~
  END
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~				text lua "Infinity_FetchString(chargen.class[rowNumber].name)"~) >= 0 BEGIN
    REPLACE_TEXTUALLY EXACT_MATCH ~				text lua "Infinity_FetchString(chargen.class[rowNumber].name)"~ ~				text lua "rgCleanSCSClassLabel(Infinity_FetchString(chargen.class[rowNumber].name))"~
  END
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~				text lua "Infinity_FetchString(chargen.class[rowNumber].name)"~) >= 0 BEGIN
    REPLACE_TEXTUALLY EXACT_MATCH ~				text lua "Infinity_FetchString(chargen.class[rowNumber].name)"~ ~				text lua "rgCleanSCSClassLabel(Infinity_FetchString(chargen.class[rowNumber].name))"~
  END
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~				text lua "Infinity_FetchString(chargen.kit[rowNumber].name)"~) >= 0 BEGIN
    REPLACE_TEXTUALLY EXACT_MATCH ~				text lua "Infinity_FetchString(chargen.kit[rowNumber].name)"~ ~				text lua "rgCleanSCSClassLabel(Infinity_FetchString(chargen.kit[rowNumber].name))"~
  END
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~				text lua "Infinity_FetchString(chargen.class[rowNumber].name)"~) >= 0 BEGIN
    REPLACE_TEXTUALLY EXACT_MATCH ~				text lua "Infinity_FetchString(chargen.class[rowNumber].name)"~ ~				text lua "rgCleanSCSClassLabel(Infinity_FetchString(chargen.class[rowNumber].name))"~
  END
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~				text lua "Infinity_FetchString(chargen.kit[rowNumber].name)"~) >= 0 BEGIN
    REPLACE_TEXTUALLY EXACT_MATCH ~				text lua "Infinity_FetchString(chargen.kit[rowNumber].name)"~ ~				text lua "rgCleanSCSClassLabel(Infinity_FetchString(chargen.kit[rowNumber].name))"~
  END
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~	--	text lua  "getUiString('LEVEL_UP_TITLE') .. ' - ' ..  characters[currentID].name .. ', ' .. characters[currentID].class"~) >= 0 BEGIN
    REPLACE_TEXTUALLY EXACT_MATCH ~	--	text lua  "getUiString('LEVEL_UP_TITLE') .. ' - ' ..  characters[currentID].name .. ', ' .. characters[currentID].class"~ ~	--	text lua  "getUiString('LEVEL_UP_TITLE') .. ' - ' ..  characters[currentID].name .. ', ' .. rgCleanSCSClassLabel(characters[currentID].class)"~
  END
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~		text lua "characters[currentID].name .. ', ' .. characters[currentID].class"~) >= 0 BEGIN
    REPLACE_TEXTUALLY EXACT_MATCH ~		text lua "characters[currentID].name .. ', ' .. characters[currentID].class"~ ~		text lua "characters[currentID].name .. ', ' .. rgCleanSCSClassLabel(characters[currentID].class)"~
  END
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~		text lua "characters[currentID].class"~) >= 0 BEGIN
    REPLACE_TEXTUALLY EXACT_MATCH ~		text lua "characters[currentID].class"~ ~		text lua "rgCleanSCSClassLabel(characters[currentID].class)"~
  END
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~text lua "dwFilterKitDesc(Infinity_FetchString(chargen.class[rowNumber].name))"~) >= 0 BEGIN
    REPLACE_TEXTUALLY EXACT_MATCH ~text lua "dwFilterKitDesc(Infinity_FetchString(chargen.class[rowNumber].name))"~ ~text lua "rgCleanSCSClassLabel(Infinity_FetchString(chargen.class[rowNumber].name))"~
  END
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~text lua "dwFilterKitDesc(Infinity_FetchString(chargen.kit[rowNumber].name))"~) >= 0 BEGIN
    REPLACE_TEXTUALLY EXACT_MATCH ~text lua "dwFilterKitDesc(Infinity_FetchString(chargen.kit[rowNumber].name))"~ ~text lua "rgCleanSCSClassLabel(Infinity_FetchString(chargen.kit[rowNumber].name))"~
  END
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~text lua "dwFilterKitDesc(characters[currentID].class)"~) >= 0 BEGIN
    REPLACE_TEXTUALLY EXACT_MATCH ~text lua "dwFilterKitDesc(characters[currentID].class)"~ ~text lua "rgCleanSCSClassLabel(characters[currentID].class)"~
  END
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~text lua "dwFilterKitDesc(characters[id].class)"~) >= 0 BEGIN
    REPLACE_TEXTUALLY EXACT_MATCH ~text lua "dwFilterKitDesc(characters[id].class)"~ ~text lua "rgCleanSCSClassLabel(characters[id].class)"~
  END
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~text lua "dwFilterKitDesc(characters[rgInvId].class)"~) >= 0 BEGIN
    REPLACE_TEXTUALLY EXACT_MATCH ~text lua "dwFilterKitDesc(characters[rgInvId].class)"~ ~text lua "rgCleanSCSClassLabel(characters[rgInvId].class)"~
  END
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~text lua "Infinity_FetchString(chargen.class[rowNumber].name)"~) >= 0 BEGIN
    PATCH_FAIL ~Class list left unfiltered: unsupported menu variant. Changes rolled back.~
  END
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~text lua "Infinity_FetchString(chargen.kit[rowNumber].name)"~) >= 0 BEGIN
    PATCH_FAIL ~Kit list left unfiltered: unsupported menu variant. Changes rolled back.~
  END
  // Additional class displays missed by v0.5.3. Match complete expressions only.
  // These are presentation paths, not the engine's class/kit or level-up data.
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~text lua "dwFilterKitDesc(chargen.information)"~) >= 0 BEGIN
    REPLACE_TEXTUALLY EXACT_MATCH ~text lua "dwFilterKitDesc(chargen.information)"~ ~text lua "rgCleanSCSClassLabel(chargen.information)"~
  END
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~text lua "chargen.information"~) >= 0 BEGIN
    REPLACE_TEXTUALLY EXACT_MATCH ~text lua "chargen.information"~ ~text lua "rgCleanSCSClassLabel(chargen.information)"~
  END
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~text lua "dwFilterKitDesc(rgGetChargenInfo(1))"~) >= 0 BEGIN
    REPLACE_TEXTUALLY EXACT_MATCH ~text lua "dwFilterKitDesc(rgGetChargenInfo(1))"~ ~text lua "rgCleanSCSClassLabel(rgGetChargenInfo(1))"~
  END
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~text lua "rgGetChargenInfo(1)"~) >= 0 BEGIN
    REPLACE_TEXTUALLY EXACT_MATCH ~text lua "rgGetChargenInfo(1)"~ ~text lua "rgCleanSCSClassLabel(rgGetChargenInfo(1))"~
  END
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~text lua "dwFilterKitDesc(rgGetChargenInfo(2))"~) >= 0 BEGIN
