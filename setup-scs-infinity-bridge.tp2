  END
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~text lua "dwFilterKitDesc(classOrGeneralHelp())"~) >= 0 BEGIN
    REPLACE_TEXTUALLY EXACT_MATCH ~text lua "dwFilterKitDesc(classOrGeneralHelp())"~ ~text lua "rgCleanSCSClassLabel(classOrGeneralHelp())"~
  END
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~text lua "dwFilterKitDesc(rgKitOrAlignmentDesc())"~) >= 0 BEGIN
    REPLACE_TEXTUALLY EXACT_MATCH ~text lua "dwFilterKitDesc(rgKitOrAlignmentDesc())"~ ~text lua "rgCleanSCSClassLabel(rgKitOrAlignmentDesc())"~
  END
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~text lua "chargen.information"~) >= 0 BEGIN
    PATCH_FAIL ~Unfiltered main character-creation information remains.~
  END
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~text lua "characters[rgInvId].class"~) >= 0 BEGIN
    PATCH_FAIL ~Unfiltered inventory class label remains.~
  END
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~text lua "rgString(characters[rgInvId].class)"~) >= 0 BEGIN
    PATCH_FAIL ~Unfiltered inventory class label remains.~
  END
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~text lua "dwFilterKitDesc(chargen.information)"~) >= 0 BEGIN
    PATCH_FAIL ~Main character-creation class still relies on broad SCS filter.~
  END
BUT_ONLY_IF_IT_CHANGES

// The optional missing localisation helper is separate. Never alter t() on
// installations where Infinity UI++ already provides it.
BEGIN ~Restore missing Infinity UI++ localisation helper only if absent~
DESIGNATED 5
REQUIRE_PREDICATE (MOD_IS_INSTALLED ~infinity_ui/infinity_ui.tp2~ 0) ~Requires Infinity UI++ core.~
REQUIRE_PREDICATE (FILE_CONTAINS ~WeiDU.log~ ~STRATAGEMS/SETUP-STRATAGEMS[.]TP2~) ~Requires SCS.~
COPY_EXISTING ~UI.menu~ ~override~
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~function t(p)~) < 0 BEGIN
    PATCH_IF INDEX_BUFFER (EXACT_MATCH ~listMetaInfo = {}~) < 0 BEGIN
      PATCH_FAIL ~Unsupported UI.menu: cannot insert localisation helper.~
    END
    REPLACE_TEXTUALLY EXACT_MATCH ~listMetaInfo = {}~ ~function t(p)%WNL%    return getUiString(p)%WNL%end%WNL%%WNL%listMetaInfo = {}~
  END
BUT_ONLY_IF_IT_CHANGES

BEGIN ~Restrict existing SCS class text filter to SCS metadata only~
DESIGNATED 15
REQUIRE_PREDICATE (MOD_IS_INSTALLED ~infinity_ui/infinity_ui.tp2~ 0) ~Requires Infinity UI++ core.~
REQUIRE_PREDICATE (FILE_CONTAINS ~WeiDU.log~ ~STRATAGEMS/SETUP-STRATAGEMS[.]TP2~) ~Requires SCS.~
REQUIRE_PREDICATE (FILE_EXISTS_IN_GAME ~M_DW_DKF.lua~) ~SCS class metadata filter is absent.~
COPY_EXISTING ~M_DW_DKF.lua~ ~override~
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~local ret=string.gsub(str,"{[^}]*}","")~) >= 0 BEGIN
    REPLACE_TEXTUALLY EXACT_MATCH ~local ret=string.gsub(str,"{[^}]*}","")~ ~local p=string.char(37)%WNL%        local ret=string.gsub(str,"{[Kk]="..p.."d+,"..p.."s*[Cc]="..p.."d+}","")~
  END
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~local ret=string.gsub(str,"{[^}]*}","")~) >= 0 BEGIN
    PATCH_FAIL ~Unsafe original SCS filter still present; no change saved.~
  END
BUT_ONLY_IF_IT_CHANGES

BEGIN ~SCS startup onOpen recovery (isolated, fail-closed)~
DESIGNATED 10
REQUIRE_PREDICATE (MOD_IS_INSTALLED ~infinity_ui/infinity_ui.tp2~ 0) ~Requires Infinity UI++ core.~
REQUIRE_PREDICATE (FILE_CONTAINS ~WeiDU.log~ ~STRATAGEMS/SETUP-STRATAGEMS[.]TP2~) ~Requires SCS.~
REQUIRE_PREDICATE (FILE_EXISTS_IN_GAME ~M_DW_OOD.lua~) ~SCS onOpen runtime is absent.~
// Does not alter UI.menu or remove valid named handlers. Repairs are restricted to
// recognisable corruption; unexpected forms abort rather than deleting code.
INCLUDE ~stratagems/sfo2e/lib_ui.tph~
COPY_EXISTING ~M_DW_OOD.lua~ ~override~
  SET cursor = INDEX_BUFFER (EXACT_MATCH ~dwOnOpenDefault['~)
  // Raw menu markup inside a Lua handler is evidence of SCS's known overmatch.
  // Recover only complete named handlers using the upstream menu's onOpen body.
  WHILE cursor >= 0 BEGIN
    SET following = INDEX_BUFFER (EXACT_MATCH ~dwOnOpenDefault['~ cursor + 1)
    PATCH_IF following < 0 BEGIN SET following = BUFFER_LENGTH END
    READ_ASCII cursor fragment (following - cursor)
    SET damaged = 0
    SPRINT menu_name ""
    INNER_PATCH_SAVE probe ~%fragment%~ BEGIN
      PATCH_IF INDEX_BUFFER (~^[ %TAB%]*}[%WNL%%LNL%%MNL%][ %TAB%]*label[%WNL%%LNL%%MNL%][ %TAB%]*{~) >= 0 BEGIN
        SET damaged = 1
        REPLACE_EVALUATE ~dwOnOpenDefault\['\([^']+\)'\]=function()~ BEGIN
          SPRINT menu_name ~%MATCH1%~
        END ~dwOnOpenDefault['%MATCH1%']=function()~
      END
    END
    PATCH_IF damaged BEGIN
      INNER_PATCH_SAVE validated ~%fragment%~ BEGIN
        PATCH_IF INDEX_BUFFER (~end[ %TAB%%WNL%%LNL%%MNL%]*$~) < 0 BEGIN
          PATCH_FAIL ~Damaged handler has unexpected trailing code; refusing replacement.~
        END
      END
      PATCH_IF ~%menu_name%~ STR_EQ ~~ BEGIN
        PATCH_FAIL ~Corrupted handler has no identifiable menu; refusing to guess.~
      END
      SPRINT recovered_body ""
      SPRINT source_menu ""
      INNER_ACTION BEGIN
        COPY - ~infinity_ui/content/UI.MENU~ nowhere
          LPF UI_return_object STR_VAR object=menu_name object_type=menu RET object_data END
          SPRINT source_menu ~%object_data%~
          INNER_PATCH_SAVE parsed ~%object_data%~ BEGIN
            REPLACE_EVALUATE CASE_INSENSITIVE ~onopen[ %TAB%]*"\([^"]*\)"~ BEGIN
              SPRINT recovered_body ~%MATCH1%~
            END ~onOpen "%MATCH1%"~
          END
        BUT_ONLY
      END
      PATCH_IF ~%source_menu%~ STR_EQ ~~ BEGIN
        PATCH_FAIL ~Cannot find damaged menu in Infinity UI++ source; no changes applied.~
      END
      PATCH_IF INDEX_BUFFER (~on[Oo]pen~) >= 0 AND ~%recovered_body%~ STR_EQ ~~ BEGIN
        PATCH_FAIL ~Could not extract the original onOpen body; refusing to discard it.~
      END
      SPRINT repaired ~dwOnOpenDefault['%menu_name%']=function()%WNL%%recovered_body%%WNL%end%WNL%%WNL%~
      DELETE_BYTES cursor (following-cursor)
      INSERT_BYTES cursor (STRING_LENGTH ~%repaired%~)
      WRITE_ASCIIE cursor ~%repaired%~
      SET cursor = cursor + STRING_LENGTH ~%repaired%~
    END ELSE BEGIN
      SET cursor = following
    END
    SET cursor = INDEX_BUFFER (EXACT_MATCH ~dwOnOpenDefault['~ cursor)
  END
  PATCH_IF INDEX_BUFFER (~^[ %TAB%]*label[%WNL%%LNL%%MNL%][ %TAB%]*{~) >= 0 BEGIN
    PATCH_FAIL ~Unrecognised damaged onOpen content; refusing destructive repair.~
  END
BUT_ONLY_IF_IT_CHANGES

BEGIN ~SCS five-point thief-skill UI compatibility (#4115 only)~
DESIGNATED 20
REQUIRE_PREDICATE (MOD_IS_INSTALLED ~infinity_ui/infinity_ui.tp2~ 0) ~Requires Infinity UI++ core.~
REQUIRE_PREDICATE (MOD_IS_INSTALLED ~stratagems/setup-stratagems.tp2~ 4115) ~Requires SCS component 4115.~
REQUIRE_PREDICATE (FILE_EXISTS_IN_GAME ~M_DW_TSF.lua~) ~Missing SCS thief functions.~
REQUIRE_PREDICATE (FILE_EXISTS_IN_GAME ~M_DW_TSD.lua~) ~Missing SCS thief definitions.~
INCLUDE ~stratagems/sfo2e/lib_ui.tph~

DEFINE_PATCH_FUNCTION iscb_skill_fields BEGIN
  // Edit within one named menu only. Do not alter every Done/Cancel in the UI.
  REPLACE_TEXTUALLY EXACT_MATCH ~dw_can_press_thief_button()~ ~iscbThiefClickable()~
  REPLACE_TEXTUALLY EXACT_MATCH ~createCharScreen:IsThiefSkillPlusMinusButtonClickable()~ ~iscbThiefClickable()~
  REPLACE_TEXTUALLY EXACT_MATCH ~dw_thiefskill_add(currentChargenThiefSkill)~ ~iscbThiefChange(true)~
  REPLACE_TEXTUALLY EXACT_MATCH ~dw_thiefskill_subtract(currentChargenThiefSkill)~ ~iscbThiefChange(false)~
  REPLACE_TEXTUALLY EXACT_MATCH ~createCharScreen:OnThiefSkillPlusMinusButtonClick(chargen.thief_skill[currentChargenThiefSkill].id, true)~ ~iscbThiefChange(true)~
  REPLACE_TEXTUALLY EXACT_MATCH ~createCharScreen:OnThiefSkillPlusMinusButtonClick(chargen.thief_skill[currentChargenThiefSkill].id, false)~ ~iscbThiefChange(false)~
  REPLACE_TEXTUALLY EXACT_MATCH ~dw_thiefskill_value(rowNumber)~ ~iscbThiefValue(rowNumber)~
  REPLACE_TEXTUALLY EXACT_MATCH ~text lua "chargen.thief_skill[rowNumber].value"~ ~text lua "iscbThiefValue(rowNumber)"~
  REPLACE_TEXTUALLY EXACT_MATCH ~dw_thiefskill_extra_points()~ ~iscbThiefRemaining()~
  REPLACE_TEXTUALLY EXACT_MATCH ~text lua "chargen.extraSkillPoints"~ ~text lua "iscbThiefRemaining()"~
  REPLACE_TEXTUALLY EXACT_MATCH ~dw_thief_skills_finished()~ ~iscbThiefDoneEnabled()~
  REPLACE_TEXTUALLY EXACT_MATCH ~clickable lua "createCharScreen:IsDoneButtonClickable()"~ ~clickable lua "iscbThiefDoneEnabled()"~
  REPLACE_TEXTUALLY EXACT_MATCH ~rgString('SKILLS_LABEL') .. ': ' .. chargen.extraSkillPoints~ ~rgString('SKILLS_LABEL') .. ': ' .. iscbThiefRemaining()~
  // Exact button actions only within the two thief menu definitions.
  REPLACE_TEXTUALLY EXACT_MATCH ~createCharScreen:OnDoneButtonClick()~ ~iscbThiefDone()~
  REPLACE_TEXTUALLY EXACT_MATCH ~createCharScreen:OnCancelButtonClick()~ ~iscbThiefCancel()~
END
DEFINE_PATCH_FUNCTION iscb_skill_chargen BEGIN
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~table "chargen.thief_skill"~) >= 0 BEGIN
    LPF iscb_skill_fields END
    REPLACE_TEXTUALLY EXACT_MATCH ~rgGetProficiencyElementsArea()~ ~rgGetProficiencyElementsArea(); iscbThiefBegin()~
    REPLACE_TEXTUALLY EXACT_MATCH ~dwOnOpen('CHARGEN_PROFICIENCIES')~ ~dwOnOpen('CHARGEN_PROFICIENCIES'); iscbThiefBegin()~
    PATCH_IF INDEX_BUFFER (EXACT_MATCH ~iscbThiefBegin()~) < 0 BEGIN
      PATCH_FAIL ~No thief character creation initialization hook found.~
    END
  END
END
DEFINE_PATCH_FUNCTION iscb_skill_levelup BEGIN
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~table "chargen.thief_skill"~) >= 0 BEGIN
    LPF iscb_skill_fields END
    REPLACE_TEXTUALLY EXACT_MATCH ~rgGetLvlUpArea()~ ~rgGetLvlUpArea(); iscbThiefBegin()~
    REPLACE_TEXTUALLY EXACT_MATCH ~dwOnOpen('LEVELUP_PROFICIENCIES')~ ~dwOnOpen('LEVELUP_PROFICIENCIES'); iscbThiefBegin()~
    PATCH_IF INDEX_BUFFER (EXACT_MATCH ~iscbThiefBegin()~) < 0 BEGIN
      PATCH_FAIL ~No thief level-up initialization hook found.~
    END
  END
END
COPY ~scs-infinity-bridge/M_ISBT.lua~ ~override/M_ISBT.lua~
COPY_EXISTING ~UI.menu~ ~override~
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~listMetaInfo = {}~) < 0 BEGIN
    PATCH_FAIL ~Unknown Infinity UI++ entry point; thief UI unchanged.~
  END
  PATCH_IF INDEX_BUFFER (EXACT_MATCH ~Infinity_DoFile("M_ISBT")~) < 0 BEGIN
    REPLACE_TEXTUALLY EXACT_MATCH ~listMetaInfo = {}~ ~Infinity_DoFile("M_ISBT")%WNL%listMetaInfo = {}~
  END
  LPF UI_alter_object STR_VAR object=CHARGEN_PROFICIENCIES object_type=menu patch=iscb_skill_chargen END
  LPF UI_alter_object STR_VAR object=LEVELUP_PROFICIENCIES object_type=menu patch=iscb_skill_levelup END
BUT_ONLY_IF_IT_CHANGES

